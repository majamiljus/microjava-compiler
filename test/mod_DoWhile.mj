program TestDoWhile
//2
//1
//2
//4
//1
//9
int sum, i;

{
    void main()
    {
        sum = 0;

        A: do
        {
            sum = sum + 2;

            print(sum);
            print(eol);

            i = 0;

            B: do
            {
                i = i + 1;

                print(i);
                print(eol);

                // Kad sum postane 4, iskoci skroz iz A
                if (sum == 4)
                    break A;

                // Inace iskoci samo iz unutrasnje B petlje
                if (i == 2)
                    break B;

            } while (i < 5);

        } while (sum < 8);

        print(9);
        print(eol);
    }
}